    u, v = first[7], first[9]
    edges.remove(tuple(sorted((u, v))))
    path = [u] + list(range(next_vertex, next_vertex + 8)) + [v]
    edges.extend(zip(path, path[1:]))
    return Graph(next_vertex + 8, tuple(edges)), deleted


