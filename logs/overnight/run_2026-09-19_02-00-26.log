                     for i in range(5)]
                intervals = [range(z[i], z[i]+size-parts.count(i)+1)
                             for i in range(5)]
                # All feasible part counts, without endpoint rounding.
                piece = min(count_cost(size, x) for x in product(*intervals))
                outside = 0
